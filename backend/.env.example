APP_ENV=development
APP_NAME=BookLeaf Support Portal

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/bookleaf_support

JWT_SECRET_KEY=replace_with_a_secure_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Server-side only. Never exposed to the React app.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768

AI_MAX_RETRIES=3
AI_RETRY_BASE_DELAY_SECONDS=1.0
AI_REQUEST_TIMEOUT_SECONDS=60
AI_MAX_RESPONSE_TOKENS=700
AI_CONVERSATION_HISTORY_LIMIT=6
AI_RETRIEVAL_TOP_K=3

CORS_ORIGINS=http://localhost:5173

# Live evaluation pacing (free Gemini tier ~5 requests/minute)
AI_EVAL_DELAY_SECONDS=13
AI_EVAL_MAX_RETRIES=6
